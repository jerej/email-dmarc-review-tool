# Gmail fetch settings
# Place OAuth desktop client JSON at project root by default:
#   credentials.json
# Override with GMAIL_CREDENTIALS_PATH if you store it elsewhere.
GMAIL_CREDENTIALS_PATH=credentials.json

# OAuth token cache created after first successful login flow.
GMAIL_TOKEN_PATH=data/gmail_token.json

# Gmail search query used by Fetch Gmail DMARC Attachments.
# Create a Gmail label (for example: DMARC-Reports), then use it here.
GMAIL_LABEL_QUERY=label:DMARC-Reports has:attachment

# Max messages pulled per API page when fetching.
GMAIL_MAX_RESULTS=100

# When true (default), mark fetched Gmail messages as read after processing.
# Set to false to leave message unread state unchanged.
# Scope mapping: true -> gmail.modify, false -> gmail.readonly.
GMAIL_MARK_AS_READ=true
